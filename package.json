{
  "name": "streamcontrol",
  "productName": "StreamControl",
  "version": "1.0.0",
  "description": "Regie video pour sources RTMP, avec MediaMTX et OBS Studio.",
  "author": {
    "name": "StreamControl",
    "email": "noreply@streamcontrol.local"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/heyhey2thereal/StreamControl.git"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:vite": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:vite && npm run build:electron",
    "vendor:mediamtx": "node scripts/fetch-mediamtx.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:publish": "npm run build && electron-builder --win --publish always",
    "test": "npm run build:electron && node --test --test-force-exit tests/logic.test.mjs tests/obs-client.test.mjs",
    "test:e2e": "node tests/e2e/app-smoke.mjs && node tests/e2e/pages.mjs && node tests/e2e/update.mjs && node tests/e2e/qol.mjs && node tests/e2e/lock.mjs && node tests/e2e/player.mjs && node tests/e2e/paths.mjs && node tests/e2e/language.mjs && node tests/e2e/ui.mjs && node tests/e2e/storage.mjs && node tests/e2e/streams.mjs && node tests/e2e/mediamtx.mjs && node tests/e2e/obs.mjs",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "icon": "node scripts/make-icon.mjs",
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.streamcontrol.app",
    "productName": "StreamControl",
    "copyright": "Copyright (c) 2026 StreamControl",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/mediamtx",
        "to": "mediamtx",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/extract-zip/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StreamControl-Setup-${version}.${ext}",
      "legalTrademarks": "StreamControl",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamControl",
      "deleteAppDataOnUninstall": false,
      "artifactName": "StreamControl-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "differentialPackage": false,
      "uninstallDisplayName": "StreamControl ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "artifactName": "StreamControl-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "StreamControl-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "StreamControl-${version}-${arch}.${ext}"
    }
  }
}
